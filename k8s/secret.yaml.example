# EXAMPLE ONLY - do not put real values here and do not commit the real secret.yaml
# to create the real secret:
#   kubectl create secret generic trackfit-secret #     --from-literal=SECRET_KEY="your-django-secret-key" #     --from-literal=DB_PASSWORD="your-db-password" #     --from-literal=AUTH0_CLIENT_ID="your-auth0-client-id" #     --from-literal=AUTH0_CLIENT_SECRET="your-auth0-client-secret" #     --from-literal=AUTH0_DOMAIN="your-auth0-domain" #     -n trackfit

apiVersion: v1
kind: Secret
metadata:
  name: trackfit-secret
  namespace: trackfit
type: Opaque
stringData:
  SECRET_KEY: "replace-with-real-secret-key"
  DB_PASSWORD: "replace-with-real-password"
  AUTH0_CLIENT_ID: "replace-with-real-client-id"
  AUTH0_CLIENT_SECRET: "replace-with-real-client-secret"
  AUTH0_DOMAIN: "replace-with-real-domain"
